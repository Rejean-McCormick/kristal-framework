      &lt;li&gt;
        &lt;label for="webId"&gt;WebID&lt;/label&gt;
        &lt;input id="webId" type="text" name="webId" autofocus&gt;
      &lt;/li&gt;
    &lt;/ol&gt;
  &lt;/fieldset&gt;

  &lt;ul class="actions"&gt;
    &lt;li&gt;&lt;button type="submit" name="submit" disabled&gt;Link WebID to account&lt;/button&gt;&lt;/li&gt;
