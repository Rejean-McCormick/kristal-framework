{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kristal.org/schemas/v3/exchange-federation-manifest.schema.json",
  "title": "Kristal v3 Exchange Federation Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "created_at",
    "federation_id",
    "canonicalization_profile",
    "canonicalization_version",
    "content_hash",
    "shards",
    "composition_policy",
    "signatures"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "3.0",
      "description": "Manifest schema version."
    },

    "artifact_type": {
      "type": "string",
      "const": "exchange_federation_manifest",
      "description": "Artifact discriminator."
    },

    "manifest_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique ID for this manifest (UUID or similar)."
    },

    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp when the manifest was produced (not part of federation hash target)."
    },

    "federation_id": {
      "$ref": "#/$defs/federation_id",
      "description": "Content-addressed ID of this federation manifest (recommended form: sha256:<hex>)."
    },

    "canonicalization_profile": {
      "type": "string",
      "const": "kristal.v3:jcs-rfc8785",
      "description": "Canonicalization profile identifier (v3 canonical)."
    },

    "canonicalization_version": {
      "type": "string",
      "const": "1",
      "description": "Canonicalization version (v3 canonical)."
    },

    "content_hash": {
      "$ref": "#/$defs/hash",
      "description": "Hash of the canonicalized federation hash_target (federation_id/content_hash/signatures/created_at excluded)."
    },

    "authority_registry_ref": {
      "$ref": "#/$defs/authority_registry_ref",
      "description": "Optional reference to pinned trust policy data used during verification."
    },

    "shards": {
      "type": "array",
      "minItems": 1,
      "description": "Referenced shards and their seals (authority signatures) or integrity references.",
      "items": { "$ref": "#/$defs/shard_ref" }
    },

    "composition_policy": {
      "$ref": "#/$defs/composition_policy",
      "description": "Deterministic composition rules (precedence / conflict handling)."
    },

    "trust_requirements": {
      "$ref": "#/$defs/trust_requirements",
      "description": "Optional policy hints for consumers (may be ignored)."
    },

    "publisher": {
      "$ref": "#/$defs/publisher",
      "description": "Optional publisher identity metadata for the federation manifest."
    },

    "signatures": {
      "type": "array",
      "minItems": 1,
      "description": "Publisher seal(s) over the federation manifest signing target (verification is fail-closed when signatures are declared).",
      "items": { "$ref": "#/$defs/signature" }
    },

    "references": {
      "type": "object",
      "description": "Optional references to specs/docs for traceability.",
      "additionalProperties": false,
      "properties": {
        "spec_version": { "type": "string", "minLength": 1 },
        "docs_uri": { "type": "string", "format": "uri" }
      }
    },

    "extensions": {
      "type": "object",
      "description": "Implementation-specific fields. Must not change core identity/hashing semantics.",
      "additionalProperties": true
    }
  },

  "$defs": {
    "sha256_hex": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },

    "sha256_prefixed": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },

    "federation_id": {
      "$ref": "#/$defs/sha256_prefixed"
    },

    "hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "value"],
      "properties": {
        "alg": {
          "type": "string",
          "description": "Hash algorithm identifier.",
          "enum": ["sha256"]
        },
        "value": {
          "$ref": "#/$defs/sha256_hex",
          "description": "Lowercase hex-encoded hash digest."
        }
      }
    },

    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "alg", "payload_hash", "signature"],
      "properties": {
        "sig_id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique signature id."
        },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "description": "Key identifier (KID) used to verify this signature."
        },
        "alg": {
          "type": "string",
          "minLength": 1,
          "description": "Signature algorithm identifier (e.g., ed25519, rsa-pss-sha256)."
        },
        "payload_hash": {
          "$ref": "#/$defs/hash",
          "description": "Hash of the signing target bytes (as defined by the signing target rules)."
        },
        "signature": {
          "type": "string",
          "minLength": 1,
          "description": "Signature value (encoding as specified by the signing profile; commonly base64url)."
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "description": "Optional signature purpose label (e.g., publisher/auditor/distributor)."
        },
        "signer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "org": { "type": "string", "minLength": 1 }
          }
        },
        "certificate_uri": {
          "type": "string",
          "format": "uri",
          "description": "Optional pointer to a certificate chain or public key material."
        }
      }
    },

    "authority_registry_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_id", "ref", "content_hash"],
      "properties": {
        "registry_id": {
          "type": "string",
          "minLength": 1,
          "description": "Identifier of the referenced authority registry. May be sha256:<hex> or a kristal:* identifier."
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "description": "Relative path/URI to the registry artifact within the distribution."
        },
        "content_hash": { "$ref": "#/$defs/hash" },
        "signatures": {
          "type": "array",
          "description": "Optional signatures for the referenced registry artifact.",
          "items": { "$ref": "#/$defs/signature" }
        }
      }
    },

    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain"],
      "properties": {
        "domain": { "type": "string", "minLength": 1 },
        "subdomain": { "type": "string", "minLength": 1 },
        "time_window": {
          "type": "string",
          "minLength": 1,
          "description": "Implementation-defined time slice label (e.g., '2026-01')."
        },
        "tenant_id": { "type": "string", "minLength": 1 },
        "env": { "type": "string", "minLength": 1 }
      }
    },

    "shard_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shard_id", "scope", "shard_manifest_ref", "shard_manifest_hash"],
      "properties": {
        "shard_id": {
          "$ref": "#/$defs/sha256_prefixed",
          "description": "Content-addressed ID of the shard Exchange (sha256:<hex>)."
        },
        "scope": { "$ref": "#/$defs/scope" },
        "shard_manifest_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Relative path/URI to the shard manifest artifact."
        },
        "shard_manifest_hash": {
          "$ref": "#/$defs/hash",
          "description": "Hash of the referenced shard manifest."
        },
        "seals": {
          "type": "array",
          "description": "Optional seal signatures copied from the shard manifest (if desired for self-contained verification).",
          "items": { "$ref": "#/$defs/signature" }
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },

    "composition_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_version"],
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1,
          "description": "Deterministic composition policy identifier."
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "description": "Policy version identifier."
        },
        "ordering": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "primary": { "type": "string", "minLength": 1 },
            "secondary": { "type": "string", "minLength": 1 },
            "tertiary": { "type": "string", "minLength": 1 }
          }
        },
        "authority_precedence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "conflict_resolution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "type": "string", "minLength": 1 },
            "tie_breaker": { "type": "string", "minLength": 1 }
          }
        },
        "parameters": {
          "type": "object",
          "description": "Additional policy parameters (must be deterministic for a given federation_id).",
          "additionalProperties": true
        }
      }
    },

    "trust_requirements": {
      "type": "array",
      "description": "Optional trust hints by scope.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope", "required_authority_class"],
        "properties": {
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "domain": { "type": "string", "minLength": 1 },
              "subdomain": { "type": "string", "minLength": 1 },
              "shard_id": { "$ref": "#/$defs/sha256_prefixed" }
            },
            "anyOf": [
              { "required": ["domain"] },
              { "required": ["shard_id"] }
            ]
          },
          "required_authority_class": {
            "type": "string",
            "enum": ["recognized", "personal", "personal_or_recognized"]
          }
        }
      }
    },

    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_id", "key_id"],
      "properties": {
        "authority_id": {
          "type": "string",
          "minLength": 1,
          "description": "Publisher authority identifier (deployment-defined)."
        },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "description": "Publisher key identifier (KID)."
        }
      }
    }
  }
}