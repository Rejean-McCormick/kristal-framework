{
"$schema": "https://json-schema.org/draft/2020-12/schema",
"$id": "https://kristal.org/schemas/v5/assertion-status.schema.json",
"title": "Kristal v5 Assertion Status",
"description": "Schema for assertion status, certainty, validation state, recognition state, and scoped epistemic classification in Kristal v5.",
"type": "object",
"additionalProperties": false,
"required": [
"schema_version",
"artifact_type",
"assertion_id",
"assertion_status",
"certainty_level",
"validation_status",
"recognition_status",
"validated_as",
"scope"
],
"properties": {
"schema_version": {
"type": "string",
"const": "5.0",
"description": "Schema version for this assertion status object."
},

```
"artifact_type": {
  "type": "string",
  "const": "assertion_status",
  "description": "Artifact discriminator."
},

"status_record_id": {
  "type": "string",
  "pattern": "^sha256:[a-f0-9]{64}$",
  "description": "Optional content-addressed identifier for this assertion status record."
},

"assertion_id": {
  "type": "string",
  "minLength": 1,
  "description": "Identifier of the assertion whose status is described."
},

"assertion_status": {
  "$ref": "#/$defs/assertion_status",
  "description": "Current epistemic status of the assertion."
},

"certainty_level": {
  "$ref": "#/$defs/certainty_level",
  "description": "Declared certainty level for the assertion in the stated scope."
},

"validation_status": {
  "$ref": "#/$defs/validation_status",
  "description": "Validation state of the assertion under the referenced validation policy and authority channel."
},

"recognition_status": {
  "$ref": "#/$defs/recognition_status",
  "description": "Authority recognition state of the assertion."
},

"validated_as": {
  "$ref": "#/$defs/validated_as",
  "description": "Epistemic mode under which the assertion is or may be validated."
},

"scope": {
  "$ref": "#/$defs/scope",
  "description": "Scope in which this assertion status applies."
},

"authority_channel": {
  "type": "string",
  "pattern": "^authority:[a-z0-9][a-z0-9._-]*$",
  "description": "Authority channel responsible for this status, validation, or recognition claim when applicable."
},

"validation_policy_ref": {
  "$ref": "#/$defs/artifact_ref",
  "description": "Reference to the validation policy used to evaluate this assertion."
},

"recognition_policy_ref": {
  "$ref": "#/$defs/artifact_ref",
  "description": "Reference to the recognition policy used to recognize this assertion."
},

"validation_refs": {
  "type": "array",
  "description": "References to validation decisions affecting this assertion.",
  "items": {
    "$ref": "#/$defs/artifact_ref"
  }
},

"authority_recognition_refs": {
  "type": "array",
  "description": "References to authority recognition records affecting this assertion.",
  "items": {
    "$ref": "#/$defs/artifact_ref"
  }
},

"provenance_refs": {
  "type": "array",
  "description": "References to provenance records supporting this assertion status.",
  "items": {
    "$ref": "#/$defs/artifact_ref"
  }
},

"evidence_refs": {
  "type": "array",
  "description": "References to evidence records supporting this assertion status.",
  "items": {
    "$ref": "#/$defs/artifact_ref"
  }
},

"lineage": {
  "$ref": "#/$defs/lineage",
  "description": "Lineage information for this assertion status."
},

"reason_codes": {
  "type": "array",
  "description": "Machine-readable reason codes explaining this assertion status.",
  "items": {
    "$ref": "#/$defs/reason_code"
  }
},

"findings": {
  "type": "array",
  "description": "Human-readable or machine-readable findings related to this status.",
  "items": {
    "$ref": "#/$defs/finding"
  }
},

"created_at": {
  "type": "string",
  "format": "date-time",
  "description": "Timestamp when this assertion status record was created. This field must not affect content-addressed identity unless a profile explicitly includes it in the hash target."
},

"created_by": {
  "$ref": "#/$defs/agent",
  "description": "Agent that created this assertion status record."
},

"expires_at": {
  "type": "string",
  "format": "date-time",
  "description": "Optional expiration time for this status record."
},

"replaces_status_record_id": {
  "type": "string",
  "pattern": "^sha256:[a-f0-9]{64}$",
  "description": "Optional previous status record replaced by this one."
},

"content_hash": {
  "$ref": "#/$defs/hash",
  "description": "Optional hash of this assertion status record with output ID fields and signatures excluded."
},

"signatures": {
  "type": "array",
  "description": "Optional signatures over this assertion status record. Signatures must be excluded from the primary content hash target.",
  "items": {
    "$ref": "#/$defs/signature"
  }
},

"extensions": {
  "type": "object",
  "description": "Implementation-specific extension fields. Extensions must not change core assertion status, certainty, validation, recognition, or scope semantics unless a declared profile explicitly defines them.",
  "additionalProperties": true
}
```

},

"$defs": {
"assertion_status": {
"type": "string",
"enum": [
"hypothesis",
"claimed",
"sourced",
"disputed",
"reviewed",
"validated",
"rejected",
"retracted",
"superseded"
]
},

```
"certainty_level": {
  "type": "string",
  "enum": [
    "unknown",
    "speculative",
    "low",
    "medium",
    "high",
    "established",
    "not_applicable"
  ]
},

"validation_status": {
  "type": "string",
  "enum": [
    "not_evaluated",
    "in_review",
    "validated",
    "conditionally_validated",
    "disputed",
    "rejected",
    "revoked"
  ]
},

"recognition_status": {
  "type": "string",
  "enum": [
    "not_evaluated",
    "recognized",
    "conditionally_recognized",
    "under_review",
    "disputed",
    "rejected",
    "deprecated",
    "revoked"
  ]
},

"validated_as": {
  "type": "string",
  "enum": [
    "hypothesis",
    "claim",
    "sourced_claim",
    "reviewed_claim",
    "high_confidence_fact",
    "institutional_reference",
    "publisher_declaration",
    "technical_specification",
    "legal_or_policy_position",
    "mythological_corpus",
    "fictional_corpus",
    "symbolic_model",
    "disputed_position",
    "rejected_claim"
  ]
},

"scope": {
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain"
  ],
  "properties": {
    "domain": {
      "type": "string",
      "enum": [
        "general",
        "wikidata",
        "science",
        "health",
        "education",
        "heritage",
        "law",
        "policy",
        "technology",
        "environment",
        "culture",
        "mythology",
        "fiction",
        "research",
        "operations",
        "civic",
        "local_notes"
      ]
    },
    "subdomain": {
      "type": "string",
      "minLength": 1
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 1
    },
    "time_window": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    }
  }
},

"artifact_ref": {
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "artifact_type"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_type": {
      "type": "string",
      "enum": [
        "structured_epistemic_state",
        "working_exchange",
        "reference_exchange",
        "runtime_pack",
        "exchange_shard_manifest",
        "exchange_federation_manifest",
        "authority_registry",
        "authority_channel",
        "authority_recognition",
        "validation_decision",
        "validation_report",
        "review_bundle",
        "revocations",
        "reader_policy",
        "transparency_log_entry",
        "dataset",
        "evidence_bundle",
        "source_document",
        "claim_ir",
        "resolved_claim_ir",
        "other"
      ]
    },
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "content_hash": {
      "$ref": "#/$defs/hash"
    }
  }
},

"hash": {
  "type": "object",
  "additionalProperties": false,
  "required": [
    "alg",
    "value"
  ],
  "properties": {
    "alg": {
      "type": "string",
      "enum": [
        "sha256"
      ]
    },
    "value": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
},

"lineage": {
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "source_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact_ref"
      }
    },
    "derived_from_assertion_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supersedes_assertion_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "merged_from_assertion_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "transforms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "transform_id",
          "transform_type"
        ],
        "properties": {
          "transform_id": {
            "type": "string",
            "minLength": 1
          },
          "transform_type": {
            "type": "string",
            "minLength": 1
          },
          "tool": {
            "$ref": "#/$defs/agent"
          },
          "config_hash": {
            "$ref": "#/$defs/hash"
          }
        }
      }
    }
  }
},

"finding": {
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "message"
  ],
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "error",
        "blocking"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact_ref"
      }
    }
  }
},

"reason_code": {
  "type": "string",
  "enum": [
    "schema_valid",
    "schema_invalid",
    "provenance_sufficient",
    "provenance_insufficient",
    "evidence_sufficient",
    "evidence_insufficient",
    "authority_recognized",
    "authority_not_recognized",
    "scope_mismatch",
    "policy_satisfied",
    "policy_failed",
    "signature_valid",
    "signature_invalid",
    "hash_valid",
    "hash_invalid",
    "conflict_detected",
    "disagreement_preserved",
    "certainty_too_low_for_policy",
    "rejected_by_authority_channel",
    "revoked_by_authority_channel"
  ]
},

"agent": {
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "name"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "individual",
        "community",
        "association",
        "research_collective",
        "academic_institution",
        "standards_body",
        "company",
        "government",
        "intergovernmental_organization",
        "ai_validator",
        "hybrid_collective",
        "software",
        "system"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "authority_channel": {
      "type": "string",
      "pattern": "^authority:[a-z0-9][a-z0-9._-]*$"
    }
  }
},

"signature": {
  "type": "object",
  "additionalProperties": false,
  "required": [
    "key_id",
    "alg",
    "signature"
  ],
  "properties": {
    "sig_id": {
      "type": "string",
      "minLength": 1
    },
    "key_id": {
      "type": "string",
      "minLength": 1
    },
    "alg": {
      "type": "string",
      "enum": [
        "ed25519",
        "rsa-pss-sha256"
      ]
    },
    "signature": {
      "type": "string",
      "minLength": 16
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
```

}
}
