{
"$schema": "https://json-schema.org/draft/2020-12/schema",
"$id": "https://kristal.org/schemas/v5/validation-report.schema.json",
"title": "Kristal v5 Validation Report",
"description": "A scoped validation report for Kristal v5 artifacts, assertions, shards, runtime packs, authority channels, or reader policies. A validation report records what was checked, by which tooling or authority context, under which policy, and with which deterministic findings. It does not imply universal truth or compilation gating.",
"type": "object",
"additionalProperties": false,
"required": [
"schema_version",
"artifact_type",
"validation_report_id",
"created_at",
"target",
"validation_status",
"issues"
],
"properties": {
"schema_version": {
"type": "string",
"description": "Schema version for this report format.",
"const": "5.0"
},

```
"artifact_type": {
  "type": "string",
  "description": "Kristal artifact type.",
  "const": "validation_report"
},

"validation_report_id": {
  "type": "string",
  "description": "Content-addressed identifier or stable identifier for this validation report.",
  "minLength": 1,
  "pattern": "^(sha256:[a-f0-9]{64}|[A-Za-z][A-Za-z0-9._:-]{0,255})$"
},

"content_hash": {
  "$ref": "#/$defs/content_hash"
},

"created_at": {
  "type": "string",
  "format": "date-time",
  "description": "UTC timestamp when the report was produced."
},

"created_by": {
  "$ref": "#/$defs/actor"
},

"canonicalization_profile": {
  "type": "string",
  "description": "Canonicalization profile used when this report is content-addressed or signed.",
  "const": "kristal.v5:jcs-rfc8785"
},

"canonicalization_version": {
  "type": "string",
  "description": "Canonicalization profile version.",
  "const": "1"
},

"target": {
  "$ref": "#/$defs/target_ref"
},

"target_level": {
  "type": "string",
  "description": "Granularity of the validated target.",
  "enum": [
    "artifact",
    "state",
    "exchange",
    "shard",
    "federation",
    "assertion",
    "authority_channel",
    "authority_registry",
    "runtime_pack",
    "reader_policy",
    "dataset",
    "export"
  ]
},

"build_id": {
  "type": "string",
  "description": "Optional compiler/build correlation ID for end-to-end traceability.",
  "minLength": 1
},

"run_id": {
  "type": "string",
  "description": "Optional validation run identifier. This may be operational rather than content-addressed.",
  "minLength": 1
},

"report_status": {
  "type": "string",
  "description": "Execution status of the validation run. This describes whether the report generation completed, not whether the target is accepted.",
  "enum": [
    "completed",
    "partial",
    "failed",
    "aborted"
  ]
},

"validation_status": {
  "type": "string",
  "description": "Scoped validation outcome for the target under the declared validation policy. This is not a universal truth status.",
  "enum": [
    "not_evaluated",
    "in_review",
    "validated",
    "conditionally_validated",
    "disputed",
    "rejected",
    "revoked"
  ]
},

"validated_as": {
  "type": "string",
  "description": "The epistemic mode or role in which the target is validated, rejected, disputed, or reviewed.",
  "enum": [
    "hypothesis",
    "claim",
    "sourced_claim",
    "reviewed_claim",
    "high_confidence_fact",
    "institutional_reference",
    "publisher_declaration",
    "technical_specification",
    "legal_or_policy_position",
    "mythological_corpus",
    "fictional_corpus",
    "symbolic_model",
    "disputed_position",
    "rejected_claim"
  ]
},

"certainty_level": {
  "type": "string",
  "description": "Overall certainty level assigned by this report, if applicable. Validation does not always imply high certainty.",
  "enum": [
    "unknown",
    "speculative",
    "low",
    "medium",
    "high",
    "established",
    "not_applicable",
    "mixed"
  ]
},

"scope": {
  "$ref": "#/$defs/scope"
},

"authority_channel": {
  "type": "string",
  "description": "Authority channel under which this report is issued or evaluated.",
  "minLength": 1,
  "pattern": "^authority:[A-Za-z0-9._:-]+$"
},

"authority_registry_ref": {
  "$ref": "#/$defs/reference"
},

"validation_policy_ref": {
  "$ref": "#/$defs/reference"
},

"recognition_refs": {
  "type": "array",
  "description": "Authority recognition records relevant to this validation report.",
  "items": {
    "$ref": "#/$defs/reference"
  }
},

"profiles": {
  "type": "array",
  "description": "Profiles enabled during validation. The v5 core profile is implicit.",
  "items": {
    "type": "string",
    "minLength": 1
  }
},

"tooling": {
  "$ref": "#/$defs/tooling"
},

"inputs": {
  "type": "object",
  "description": "Identifiers for validated artifacts, snapshots, profiles, or input corpora.",
  "additionalProperties": false,
  "properties": {
    "structured_epistemic_state_ref": {
      "$ref": "#/$defs/reference"
    },
    "exchange_ref": {
      "$ref": "#/$defs/reference"
    },
    "runtime_pack_ref": {
      "$ref": "#/$defs/reference"
    },
    "shard_ref": {
      "$ref": "#/$defs/reference"
    },
    "federation_ref": {
      "$ref": "#/$defs/reference"
    },
    "authority_registry_ref": {
      "$ref": "#/$defs/reference"
    },
    "source_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "recipe_id": {
      "type": "string",
      "minLength": 1
    },
    "reader_policy_ref": {
      "$ref": "#/$defs/reference"
    }
  }
},

"stats": {
  "type": "object",
  "description": "Summary counts for dashboards, review, policy decisions, and operational monitoring.",
  "additionalProperties": false,
  "properties": {
    "error_count": {
      "type": "integer",
      "minimum": 0
    },
    "warning_count": {
      "type": "integer",
      "minimum": 0
    },
    "info_count": {
      "type": "integer",
      "minimum": 0
    },
    "validated_count": {
      "type": "integer",
      "minimum": 0
    },
    "conditionally_validated_count": {
      "type": "integer",
      "minimum": 0
    },
    "disputed_count": {
      "type": "integer",
      "minimum": 0
    },
    "rejected_count": {
      "type": "integer",
      "minimum": 0
    },
    "not_evaluated_count": {
      "type": "integer",
      "minimum": 0
    }
  }
},

"limits": {
  "type": "object",
  "description": "Resource limits applied during validation, especially for expensive profiles.",
  "additionalProperties": false,
  "properties": {
    "timeout_ms": {
      "type": "integer",
      "minimum": 0
    },
    "iteration_cap": {
      "type": "integer",
      "minimum": 0
    },
    "memory_cap_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "max_issue_count": {
      "type": "integer",
      "minimum": 0
    }
  }
},

"findings": {
  "type": "array",
  "description": "Structured validation findings. Findings may apply to artifacts, shards, assertions, authority channels, runtime packs, exports, or reader policies.",
  "items": {
    "$ref": "#/$defs/finding"
  }
},

"issues": {
  "type": "array",
  "description": "Deterministic issues emitted by validation.",
  "items": {
    "$ref": "#/$defs/issue"
  }
},

"shacl": {
  "type": "object",
  "description": "Optional SHACL validation output.",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "report_uri": {
      "type": "string",
      "format": "uri"
    },
    "report_hash": {
      "$ref": "#/$defs/content_hash"
    },
    "report_format": {
      "type": "string",
      "description": "Serialization format of the report if report_uri is provided.",
      "enum": [
        "text/turtle",
        "application/n-triples",
        "application/n-quads",
        "application/ld+json",
        "application/rdf+xml"
      ]
    }
  }
},

"shex": {
  "type": "object",
  "description": "Optional ShEx validation output.",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "report_uri": {
      "type": "string",
      "format": "uri"
    },
    "report_hash": {
      "$ref": "#/$defs/content_hash"
    },
    "report_format": {
      "type": "string",
      "enum": [
        "application/json",
        "text/plain"
      ]
    }
  }
},

"export_validation": {
  "type": "object",
  "description": "Optional results for validating deterministic exports such as JSON-LD, RDF, WDQS-compatible output, or RDFC integrity.",
  "additionalProperties": false,
  "properties": {
    "jsonld_profile": {
      "type": "string",
      "minLength": 1
    },
    "rdf_profile": {
      "type": "string",
      "minLength": 1
    },
    "wdqs_compat": {
      "type": "boolean"
    },
    "rdf_hash": {
      "type": "string",
      "description": "Optional rdf_hash when RDFC integrity profile is enabled.",
      "minLength": 1
    },
    "export_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      }
    }
  }
},

"lineage": {
  "$ref": "#/$defs/lineage"
},

"signatures": {
  "type": "array",
  "description": "Signatures over this validation report according to the active signature profile.",
  "items": {
    "$ref": "#/$defs/signature"
  }
},

"attestations": {
  "type": "array",
  "description": "Optional attestations attached to this report. Separate referenced attestations are preferred when they may change independently.",
  "items": {
    "$ref": "#/$defs/reference"
  }
},

"extensions": {
  "type": "object",
  "description": "Implementation-specific additional fields. Extensions must not change v5 core conformance semantics.",
  "additionalProperties": true
}
