{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kristal.org/schemas/v3/revocations.schema.json",
  "title": "Kristal v3 Revocations List",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "revocations_id",
    "created_at",
    "canonicalization_profile",
    "canonicalization_version",
    "content_hash",
    "scope",
    "revoked_keys",
    "signatures"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "3.0",
      "description": "Schema version for this revocations list format."
    },

    "artifact_type": {
      "type": "string",
      "const": "revocations",
      "description": "Artifact discriminator."
    },

    "revocations_id": {
      "type": "string",
      "minLength": 1,
      "description": "Content-addressed ID for this revocations list artifact."
    },

    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp when this revocations list was produced."
    },

    "canonicalization_profile": {
      "type": "string",
      "const": "kristal.v3:jcs-rfc8785",
      "description": "Canonicalization profile identifier (v3 canonical)."
    },

    "canonicalization_version": {
      "type": "string",
      "const": "1",
      "description": "Canonicalization version (v3 canonical)."
    },

    "content_hash": {
      "$ref": "#/$defs/hash",
      "description": "Hash of the canonicalized revocations content with signatures excluded."
    },

    "scope": {
      "$ref": "#/$defs/scope",
      "description": "Scope for which these revocations apply (tenant/environment + optional domain constraints)."
    },

    "revoked_keys": {
      "type": "array",
      "minItems": 0,
      "description": "Revoked signing keys and metadata.",
      "items": { "$ref": "#/$defs/revoked_key" }
    },

    "signatures": {
      "type": "array",
      "minItems": 1,
      "description": "Signatures over the revocations signing target (verification is fail-closed when signatures are declared).",
      "items": { "$ref": "#/$defs/signature" }
    },

    "extensions": {
      "type": "object",
      "description": "Implementation-specific fields. Must not change core identity/hashing semantics.",
      "additionalProperties": true
    }
  },

  "$defs": {
    "hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "value"],
      "properties": {
        "alg": { "type": "string", "enum": ["sha256"] },
        "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },

    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id", "env"],
      "properties": {
        "tenant_id": { "type": "string", "minLength": 1 },
        "env": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "minLength": 1 },
        "subdomain": { "type": "string", "minLength": 1 }
      }
    },

    "revoked_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "revoked_at", "reason"],
      "properties": {
        "key_id": {
          "type": "string",
          "minLength": 1,
          "description": "Revoked key identifier (KID)."
        },
        "revoked_at": {
          "type": "string",
          "format": "date-time",
          "description": "When the key became invalid."
        },
        "reason": {
          "type": "string",
          "enum": ["compromised", "rotated", "deprecated", "policy", "unknown"]
        },
        "details": { "type": "string" },

        "effective_from": {
          "type": "string",
          "format": "date-time",
          "description": "Optional effective time (if different from revoked_at)."
        },

        "replaces_key_id": {
          "type": "string",
          "minLength": 1,
          "description": "Optional pointer to a replacement key id."
        }
      }
    },

    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "alg", "payload_hash", "signature"],
      "properties": {
        "sig_id": { "type": "string", "minLength": 1 },
        "key_id": { "type": "string", "minLength": 1 },
        "alg": { "type": "string", "enum": ["ed25519", "rsa-pss-sha256"] },
        "payload_hash": { "$ref": "#/$defs/hash" },
        "signature": { "type": "string", "minLength": 16 },
        "created_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}